<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="16dp"
            android:contentDescription="أيقونة ترجمان"
            android:src="@drawable/ic_quill_ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ترجمان"
            android:textColor="#FFD54F"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="مترجم فوري عائم فوق جميع التطبيقات
(العربية ⇄ الإنجليزية)"
            android:textColor="#CBD5E1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvModelStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_floating_card"
            android:gravity="center"
            android:padding="12dp"
            android:text="جاري فحص حزم اللغة (العربية / الإنجليزية)..."
            android:textColor="#4FC3F7"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOverlayPermission"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="1. تفعيل الظهور فوق التطبيقات"
            android:textColor="#0F172A"
            android:textStyle="bold"
            app:backgroundTint="#FFD54F"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccessibilityPermission"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="2. تفعيل خدمة قراءة الشاشة (ترجمان)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#1E293B"
            app:cornerRadius="14dp"
            app:strokeColor="#FFD54F"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleFloating"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:text="تشغيل أيقونة الريشة العائمة"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#0284C7"
            app:cornerRadius="16dp" />

    </LinearLayout>
</ScrollView>

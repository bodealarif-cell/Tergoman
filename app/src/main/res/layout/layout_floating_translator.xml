<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- 1. أيقونة الريشة العائمة (Glass Orb) -->
    <FrameLayout
        android:id="@+id/floatingBubbleContainer"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:background="@drawable/bg_floating_orb"
        android:elevation="12dp"
        android:padding="4dp">

        <ImageView
            android:id="@+id/ivQuillIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_quill_ink" />
    </FrameLayout>

    <!-- 2. لوحة الترجمة الزجاجية الفورية (Super Blur Glass Panel) -->
    <LinearLayout
        android:id="@+id/expandedPanelContainer"
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_super_glass_panel"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <!-- شريط التحكم العلوي -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_quill_ink" />

            <TextView
                android:id="@+id/tvDetectedDirection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="عربي ⇄ English"
                android:textColor="#FBBF24"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- زر مسح الشاشة -->
            <TextView
                android:id="@+id/btnReadScreen"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_glass_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="مسح الشاشة"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- تصغير للريشة -->
            <TextView
                android:id="@+id/btnMinimize"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_glass_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- حقل النص الأصلي -->
        <EditText
            android:id="@+id/etSourceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_inner_box"
            android:hint="اكتب أو الصق النص..."
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minHeight="60dp"
            android:padding="12dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="14sp" />

        <!-- أزرار التفاعل السريع -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnTranslateNow"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_accent_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="ترجم الآن"
                android:textColor="#060913"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPasteClipboard"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_glass_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="لصق"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClearText"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_glass_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="مسح"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- صندوق النتيجة الزجاجي -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="115dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_glass_result_box"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvTranslatedResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="..."
                android:textColor="#F8FAFC"
                android:textIsSelectable="true"
                android:textSize="15sp" />
        </ScrollView>

        <!-- زر نسخ النتيجة -->
        <TextView
            android:id="@+id/btnCopyResult"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="نسخ الترجمة"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>
</FrameLayout>
